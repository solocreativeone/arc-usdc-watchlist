# Get this from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Same Arc mainnet RPC URL used for deploying the contract
ARC_MAINNET_RPC_URL=https://arc-mainnet.g.alchemy.com/v2/YOUR_API_KEY

# Wallet the bot uses to submit addWatch/removeWatch txs (needs a small
# amount of USDC on Arc mainnet to pay gas). Do not reuse your deployer key
# in production; a separate hot wallet is safer.
BOT_PRIVATE_KEY=

# Printed by `npm run deploy:arc` from the project root
REGISTRY_ADDRESS=

# USDC token address on Arc mainnet. Verify this on explorer.arc.io before
# running, mainnet addresses for new chains are worth double-checking.
USDC_ADDRESS=0x3600000000000000000000000000000000000000

POLL_INTERVAL_SECONDS=15
