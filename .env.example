# Hardhat / deploy config
# RPC URL for Arc mainnet from a supported provider (Alchemy, Blockdaemon, dRPC, QuickNode)
ARC_MAINNET_RPC_URL=https://arc-mainnet.g.alchemy.com/v2/YOUR_API_KEY

# Private key of the wallet that deploys the contract and pays gas in USDC.
# Never commit the real value.
PRIVATE_KEY=
